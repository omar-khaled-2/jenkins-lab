pipeline {
    // Run on the 'main' Jenkins agent
    agent { label 'main' }
    options {
        disableConcurrentBuilds(abortPrevious: true)
    }

    stages {
        // Run backend and frontend tests sequentially using Docker containers
        stage('Backend Tests') {
            steps {
                dir('backend') {
                    sh 'npm install'
                    sh 'npm run test'
                }
            }
        }
        // Run frontend tests inside a Node.js Docker container
        stage('Frontend Tests') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                    sh 'npm run test'
                }
            }
        }
    }
}
