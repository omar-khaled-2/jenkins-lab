pipeline {
    // Run on any available Jenkins agent
    agent any
    options {
        disableConcurrentBuilds(abortPrevious: true)
    }

    stages {
        // Run backend and frontend tests sequentially using Docker containers
        stage('Backend Tests') {
            agent {
                // Use Docker container agent with Node.js 24 Alpine image
                docker {
                    image 'node:24-alpine'
                }
            }
            steps {
                dir('backend') {
                    sh 'npm install'
                    sh 'npm run test'
                }
            }
        }
        // Run frontend tests inside a Node.js Docker container
        stage('Frontend Tests') {
            agent {
                // Use Docker container agent with Node.js 24 Alpine image
                docker {
                    image 'node:24-alpine'
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm install'
                    sh 'npm run test'
                }
            }
        }
    }
    post {
        success {
            slackSend message: 'Build succeeded!', color: 'good'
        }
        failure {
            slackSend message: 'Build failed!', color: 'danger'
        }
    }
}
