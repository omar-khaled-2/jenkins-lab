@Library('jenkins-lab') _

pipeline {
    // Run on any available Jenkins agent
    agent any
    options {
        disableConcurrentBuilds(abortPrevious: true)
    }

    stages {
        // Run backend and frontend tests sequentially using Docker containers
        stage('hello'){
            steps {
                echo 'Hello, Jenkins!'
            }
        }
    }
    post {
        success {
            notifySlack(is_success: true)
        }
        failure {
            notifySlack(is_success: false)
        }
    }
}
