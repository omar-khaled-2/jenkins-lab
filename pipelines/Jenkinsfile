pipeline {
    // Run on any available Jenkins agent
    agent any

    stages {
        // Run backend and frontend tests in parallel using Docker containers
        stage('Test') {
            parallel {
                // Run backend tests inside a Node.js Docker container
                stage('Backend Tests') {
                    agent {
                        // Use Docker container agent with Node.js 24 Alpine image
                        dockerContainer {
                            image 'node:24-alpine'
                        }
                    }
                    steps {
                        dir('backend') {
                            sh 'npm install'
                            sh 'npm run test'
                        }
                    }
                }
                // Run frontend tests inside a Node.js Docker container
                stage('Frontend Tests') {
                    agent {
                        // Use Docker container agent with Node.js 24 Alpine image
                        dockerContainer {
                            image 'node:24-alpine'
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh 'npm install'
                            sh 'npm run test'
                        }
                    }
                }
            }
        }
    }
}
