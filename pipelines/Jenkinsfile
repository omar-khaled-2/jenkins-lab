pipeline {
    agent any

    stages {

        stage('Test') {
            parallel {
                stage('Backend Tests') {
                    agent {
                        dockerContainer {
                            image 'node:24-alpine'
                        }
                    }
                    steps {
                        dir('backend') {
                            sh 'npm install'
                            sh 'npm run test'
                        }
                    }
                }
                stage('Frontend Tests') {
                    agent {
                        dockerContainer {
                            image 'node:24-alpine'
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh 'npm install'
                            sh 'npm run test'
                        }
                    }
                }
            }
        }
    }
}
